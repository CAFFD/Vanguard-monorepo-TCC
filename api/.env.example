# =============================================================================
# Vanguard API — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para `.env` e preencha os valores.
# O arquivo `.env` real NUNCA deve ser commitado no git.
# Na Vercel, configure estas variáveis em: Settings -> Environment Variables
# =============================================================================

# Ambiente de execução: development | test | production
NODE_ENV=development

# Conexão com o banco de dados PostgreSQL (Supabase)
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=

# Segredo de assinatura JWT (HS256) — mínimo 32 caracteres de alta entropia.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Tempo de vida da sessão em horas (padrão: 8)
SESSION_TTL_HOURS=8

# Chave secreta M2M exigida no cabeçalho `x-api-key` em POST /telemetry
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_KEY=

# Origens autorizadas pelo CORS (separadas por vírgula, sem barra final)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Política SameSite do cookie de sessão: lax | strict | none
COOKIE_SAMESITE=lax

# Limite de tentativas de login por minuto por IP (proteção contra força bruta)
LOGIN_RATE_LIMIT_MAX=10
